# ─── .env de production (OVH Perso ou Infomaniak) ─────────────────
# Copié automatiquement en .env dans l'archive par build-deploy.sh.
APP_NAME="ACDM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.acdm.eu
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE=Europe/Brussels

# Page /installation?cle=... : à vider dès que le site est installé.
INSTALL_TOKEN=

LOG_CHANNEL=single
LOG_LEVEL=warning

# Base MySQL OVH (Espace client > Hébergements > Bases de données)
DB_CONNECTION=mysql
DB_HOST=acdmikvnliege.mysql.db
DB_PORT=3306
DB_DATABASE=acdmikvnliege
DB_USERNAME=acdmikvnliege
DB_PASSWORD=

# Fichiers plutôt que base : robustes sur un hébergement mutualisé.
SESSION_DRIVER=file
SESSION_LIFETIME=240
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Envoi des e-mails via une boîte OVH (MX Plan) — environ 200 envois / heure
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=ssl0.ovh.net
MAIL_PORT=465
MAIL_USERNAME=newsletter@acdm.eu
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=newsletter@acdm.eu
MAIL_FROM_NAME="ACDM - Concerts du Dimanche Matin"

ACDM_CONTACT_EMAIL=cecile.leleux.be@gmail.com
ACDM_BOOKING_EMAIL=valdescamps@hotmail.com
ACDM_PHONE="0499 25 95 30"
ACDM_PRIVACY_EMAIL=cecile.leleux.be@gmail.com
ACDM_GALLERY_URL=/igalerie/
# Pages officielles (laisser vide si inexistantes)
# Groupe Facebook (lien de pied de page)
ACDM_FACEBOOK_GROUP_URL=https://www.facebook.com/groups/638213836717180
# Page Facebook officielle de l'ACDM, quand elle existera
ACDM_FACEBOOK_URL=
ACDM_INSTAGRAM_URL=
ACDM_YOUTUBE_URL=
NEWSLETTER_BATCH_SIZE=150
NEWSLETTER_PAUSE_MS=250
